import { createHash, randomBytes, scrypt as scryptCallback, timingSafeEqual } from 'node:crypto';
import { promisify } from 'node:util';
import { env } from '../config/env';

const scrypt = promisify(scryptCallback);
const SESSION_DAYS = 7;
const VERIFY_HOURS = 24;

export type AuthUser = {
  id: string;
  name: string;
  email: string;
  role: 'ADMIN' | 'SALES' | 'VIEWER';
};

const hashToken = (token: string) =>
  createHash('sha256').update(token).digest('hex');

async function hashPassword(password: string): Promise<string> {
  if (password.length < 12 || password.length > 256) {
    throw new Error('Password must be 12–256 characters long');
  }

  const salt = randomBytes(16).toString('hex');
  const key = (await scrypt(password, salt, 64)) as Buffer;
  return `scrypt$${salt}$${key.toString('hex')}`;
}

async function verifyPassword(password: string, stored: string): Promise<boolean> {
  const [algorithm, salt, hex] = stored.split('$');
  if (algorithm !== 'scrypt' || !salt || !hex) return false;

  const expected = Buffer.from(hex, 'hex');
  const actual = (await scrypt(password, salt, expected.length)) as Buffer;
  return actual.length === expected.length && timingSafeEqual(actual, expected);
}

export class AuthService {
  constructor(private readonly db: any) {}

  private publicUser(user: any): AuthUser {
    return {
      id: user.id,
      name: user.name,
      email: user.email,
      role: user.role,
    };
  }

  async sendVerificationEmail(email: string, token: string): Promise<void> {
    if (env.email.provider !== 'resend' || !env.email.apiKey) {
      throw new Error('Email is not configured. Set EMAIL_PROVIDER=resend and EMAIL_API_KEY.');
    }

    const verifyUrl =
      `${env.appBaseUrl.replace(/\/$/, '')}/#/verify-email?token=${encodeURIComponent(token)}`;

    const response = await fetch('https://api.resend.com/emails', {
      method: 'POST',
      headers: {
        authorization: `Bearer ${env.email.apiKey}`,
        'content-type': 'application/json',
      },
      body: JSON.stringify({
        from: env.email.from,
        to: [email],
        subject: 'Verify your ETechMatter Intelligence account',
        text: `Verify your account using this link. It expires in ${VERIFY_HOURS} hours:\n\n${verifyUrl}\n\nIf you did not expect this invitation, ignore this email.`,
      }),
    });

    if (!response.ok) {
      throw new Error(`Verification email delivery failed (HTTP ${response.status})`);
    }
  }

  async inviteUser(input: {
    name: string;
    email: string;
    role: 'ADMIN' | 'SALES' | 'VIEWER';
  }): Promise<{ id: string; name: string; email: string; role: string }> {
    const email = input.email.trim().toLowerCase();
    const name = input.name.trim();

    if (!name || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      throw new Error('Valid name and email are required');
    }

    const user = await this.db.user.findUnique({ where: { email } });
    if (user) throw new Error('A user with this email already exists');

    const pending = await this.db.user.create({
      data: { name, email, role: input.role },
      select: { id: true, name: true, email: true, role: true },
    });

    const token = randomBytes(32).toString('base64url');

    try {
      await this.db.emailVerificationToken.create({
        data: {
          userId: pending.id,
          tokenHash: hashToken(token),
          expiresAt: new Date(Date.now() + VERIFY_HOURS * 60 * 60 * 1000),
        },
      });

      await this.sendVerificationEmail(email, token);
      return pending;
    } catch (error) {
      // Keep the account unverified; never activate it if delivery fails.
      throw error;
    }
  }

  async verifyEmail(token: string, password: string): Promise<AuthUser> {
    if (!token || token.length > 200) throw new Error('Invalid or expired verification link');

    const record = await this.db.emailVerificationToken.findUnique({
      where: { tokenHash: hashToken(token) },
      include: { user: true },
    });

    if (
      !record ||
      record.consumedAt ||
      record.expiresAt <= new Date() ||
      !record.user
    ) {
      throw new Error('Invalid or expired verification link');
    }

    const passwordHash = await hashPassword(password);

    return this.db.$transaction(async (tx: any) => {
      const consumed = await tx.emailVerificationToken.updateMany({
        where: {
          id: record.id,
          consumedAt: null,
          expiresAt: { gt: new Date() },
        },
        data: { consumedAt: new Date() },
      });

      if (consumed.count !== 1) {
        throw new Error('Verification link has already been used or expired');
      }

      const user = await tx.user.update({
        where: { id: record.userId },
        data: {
          passwordHash,
          pendingPasswordHash: null,
          emailVerifiedAt: new Date(),
        },
      });

      return this.publicUser(user);
    });
  }

  async login(emailInput: string, password: string) {
    const email = emailInput.trim().toLowerCase();
    const user = await this.db.user.findUnique({ where: { email } });

    if (
      !user ||
      !user.passwordHash ||
      !user.emailVerifiedAt ||
      !(await verifyPassword(password, user.passwordHash))
    ) {
      throw new Error('Invalid email or password, or account not verified');
    }

    const token = randomBytes(32).toString('base64url');
    const expiresAt = new Date(Date.now() + SESSION_DAYS * 24 * 60 * 60 * 1000);

    await this.db.authSession.create({
      data: {
        userId: user.id,
        tokenHash: hashToken(token),
        expiresAt,
      },
    });

    return { user: this.publicUser(user), token, expiresAt };
  }

  async authenticate(token: string | null | undefined): Promise<AuthUser | null> {
    if (!token) return null;

    const session = await this.db.authSession.findUnique({
      where: { tokenHash: hashToken(token) },
      include: { user: true },
    });

    if (!session || session.expiresAt <= new Date() || !session.user.emailVerifiedAt) {
      if (session) {
        await this.db.authSession.deleteMany({ where: { id: session.id } });
      }
      return null;
    }

    return this.publicUser(session.user);
  }

  async logout(token: string | null | undefined): Promise<void> {
    if (!token) return;
    await this.db.authSession.deleteMany({ where: { tokenHash: hashToken(token) } });
  }
    async resetUserPassword(
    userId: string,
    password: string,
  ): Promise<void> {
    if (!userId?.trim()) {
      throw new Error('User ID is required');
    }

    const passwordHash = await hashPassword(password);

    await this.db.$transaction(async (tx: any) => {
      const user = await tx.user.findUnique({
        where: { id: userId },
        select: { id: true },
      });

      if (!user) {
        throw new Error('User not found');
      }

      await tx.user.update({
        where: { id: userId },
        data: {
          passwordHash,
          pendingPasswordHash: null,
        },
      });

      // Reset ke baad user ke tamam sessions invalidate honge
      await tx.authSession.deleteMany({
        where: { userId },
      });
    });
  }

 
  }

