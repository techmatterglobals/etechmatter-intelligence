# ─────────────────────────────────────────────────────────────
# ETechMatter Intelligence — server configuration
# Copy to server/.env (the API and the Prisma CLI both read it there). Never commit .env.
# Secrets are read ONLY by the Node server; nothing here reaches the browser.
# ─────────────────────────────────────────────────────────────

PORT=4000
APP_BASE_URL=http://localhost:5173          # used in alert e-mail/webhook links
# APP_BASIC_AUTH=sales:change-me             # optional: password-protect the whole app

# ── Database ────────────────────────────────
# PostgreSQL (docker compose up -d db starts one on 5432)
DATABASE_URL=postgresql://etm:etm@localhost:5432/etm_intel?schema=public
# DATA_STORE=memory                          # force in-memory mode (no DB; data lost on restart)
SEED_DEMO_DATA=false                          # load clearly-labelled DEMO data into an empty DB
DEMO_FEED_ENABLED=false                       # keep the "Demo Feed" source (set false in production)

# ── Scheduler ───────────────────────────────
SCHEDULER_ENABLED=true

# ── SAM.gov Contract Opportunities (official API) ─────────────
# Get a key: sam.gov → sign in → Account Details → Public API Key
SAM_API_KEY=
SAM_SYNC_INTERVAL_MINUTES=15
SAM_DAILY_REQUEST_LIMIT=10                   # set to your key's real daily quota; the connector never exceeds it
SAM_POSTED_LOOKBACK_DAYS=3
SAM_NOTICE_TYPES=o,k,p,r,s                   # solicitation, combined, presolicitation, sources sought, special notice
# SAM_NAICS_CODES=334111,334112,334118,334210,334220,334290,334419,335999,423430,423690,541519
# SAM_PSC_PREFIXES=70,58,59,61,7A,7B,7C,7D,7E,7F,7G,7H,7J,7K
SAM_FETCH_DESCRIPTIONS=false                 # true = also download notice descriptions (costs 1 request each)
SAM_MAX_PAGES_PER_RUN=2
# SAM_API_BASE_URL=https://api.sam.gov/opportunities/v2/search

# ── USAspending.gov (historical awards, public, no key) ───────
USASPENDING_ENABLED=true
USASPENDING_SYNC_INTERVAL_MINUTES=1440
USASPENDING_LOOKBACK_DAYS=365
USASPENDING_NAICS_CODES=334111,334112,334118,423430
USASPENDING_MAX_RECORDS=200

# ── Public web discovery (only public pages that allow crawling) ──
WEB_DISCOVERY_URLS=                          # comma-separated pages or RSS feeds (also editable in /admin)
WEB_SYNC_INTERVAL_MINUTES=120
WEB_USER_AGENT=ETechMatterIntelligenceBot/1.0 (+https://etechmatter.com)

# ── State & local procurement portals ─────────
STATE_SYNC_INTERVAL_MINUTES=60
# STATE_PORTAL_FEEDS=[{"name":"Example County Bids","state":"TX","sourceType":"LOCAL_PROCUREMENT","format":"rss","url":"https://example-county.gov/bids.rss","organizationName":"Example County"}]

# ── AI provider (optional — the built-in rules engine works without any key) ──
AI_PROVIDER=heuristic                        # heuristic | anthropic | openai
AI_MODEL=                                    # e.g. a current Claude or OpenAI model id
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1  # any OpenAI-compatible endpoint
AI_MAX_CONCURRENCY=2

# ── Alert e-mail (optional) ───────────────────
EMAIL_PROVIDER=                              # resend
EMAIL_API_KEY=
EMAIL_FROM=alerts@etechmatter.com
